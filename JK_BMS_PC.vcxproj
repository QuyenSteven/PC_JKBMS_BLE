<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals"><VCProjectVersion>17.0</VCProjectVersion><Keyword>Win32Proj</Keyword><ProjectGuid>{CBCA4637-BC39-4C20-AB2B-A14E78531674}</ProjectGuid><RootNamespace>JK_BMS_PC</RootNamespace><WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion></PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration"><ConfigurationType>Application</ConfigurationType><UseDebugLibraries>true</UseDebugLibraries><PlatformToolset Condition="'$(VisualStudioVersion)' == '18.0'">v145</PlatformToolset><PlatformToolset Condition="'$(VisualStudioVersion)' != '18.0'">v143</PlatformToolset><CharacterSet>Unicode</CharacterSet></PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration"><ConfigurationType>Application</ConfigurationType><UseDebugLibraries>false</UseDebugLibraries><PlatformToolset Condition="'$(VisualStudioVersion)' == '18.0'">v145</PlatformToolset><PlatformToolset Condition="'$(VisualStudioVersion)' != '18.0'">v143</PlatformToolset><WholeProgramOptimization>true</WholeProgramOptimization><CharacterSet>Unicode</CharacterSet></PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <!-- Use an explicit NuGet package include directory and static loader to avoid
       reliance on native NuGet props imports across VS2022/VS2026. -->
  <PropertyGroup>
    <WebView2NativeDir>$(MSBuildProjectDirectory)\packages\Microsoft.Web.WebView2.1.0.2903.40\build\native\</WebView2NativeDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <WarningLevel>Level4</WarningLevel>
      <PreprocessorDefinitions>WIN32;_WINDOWS;UNICODE;_UNICODE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(WebView2NativeDir)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <AdditionalLibraryDirectories>$(WebView2NativeDir)$(Platform);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>WebView2LoaderStatic.lib;WindowsApp.lib;Comctl32.lib;Comdlg32.lib;Ole32.lib;Shell32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup><ClCompile Include="src\main.cpp" /></ItemGroup>
  <ItemGroup><None Include="web\index.html" /><None Include="packages.config" /></ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

  <Target Name="VerifyWebView2Sdk" BeforeTargets="ClCompile">
    <Error Condition="!Exists('$(WebView2NativeDir)include\WebView2.h')" Text="WebView2 SDK header missing: use Solution -> Restore NuGet Packages (packages.config), then Rebuild. Expected: $(WebView2NativeDir)include\WebView2.h" />
    <Error Condition="!Exists('$(WebView2NativeDir)$(Platform)\WebView2LoaderStatic.lib')" Text="WebView2 SDK native loader missing: restore NuGet package Microsoft.Web.WebView2 1.0.2903.40." />
  </Target>
  <Target Name="CopyWebUI" AfterTargets="Build">
    <MakeDir Directories="$(TargetDir)web" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\web\index.html" DestinationFiles="$(TargetDir)web\index.html" SkipUnchangedFiles="true" />
  </Target>
</Project>