<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- One deterministic package location for local VS2026 and CI. -->
    <add key="globalPackagesFolder" value="packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
